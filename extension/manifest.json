{
  "manifest_version": 3,
  "name": "DeepSeek Capture (dsh-deepseek-capture)",
  "version": "0.1.0",
  "description": "Auto-capture chat.deepseek.com conversations and sync them to your local DeepSeek Harness plugin. 100% local, zero upload.",
  "default_locale": "en",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepSeek Capture"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
